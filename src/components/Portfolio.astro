---
import { content, skills, social, type Locale } from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import UiIcon from './UiIcon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
const isFa = locale === 'fa';
const alternate = isFa ? '/' : '/fa/';
const year = new Date().getFullYear();
---
<BaseLayout locale={locale}>
  <div class="page-shell" id="top">
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={isFa ? '/fa/' : '/'} aria-label="Foroozan Iraji — Home">
          <span class="brand-mark" aria-hidden="true">fi<span>.</span></span>
          <span class="brand-copy"><strong>Foroozan Iraji</strong><small>PRODUCT BUILDER</small></span>
        </a>
        <nav class="main-nav" id="main-navigation" aria-label={isFa ? 'ناوبری اصلی' : 'Main navigation'} data-nav data-open="false">
          <a href="#projects">{t.nav.projects}</a>
          <a href="#expertise">{t.nav.expertise}</a>
          <a href="#experience">{t.nav.experience}</a>
          <a href="#contact">{t.nav.contact}</a>
        </nav>
        <div class="header-actions">
          <a href={alternate} class="language-switch" aria-label={t.nav.locale} title={t.nav.locale}>
            <UiIcon name="globe" size={17} /> <span>{t.nav.language}</span>
          </a>
          <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label={t.nav.theme} title={t.nav.theme}>
            <UiIcon name="moon" class="theme-moon" size={19} />
            <UiIcon name="sun" class="theme-sun" size={19} />
          </button>
          <button class="icon-button menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="main-navigation" aria-label={t.nav.menu}>
            <UiIcon name="menu" class="menu-open-icon" size={22} />
            <UiIcon name="close" class="menu-close-icon" size={22} />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero-section container" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <div class="eyebrow"><span class="gold-dot"></span>{t.hero.kicker}</div>
          <p class="hero-introduction">{t.hero.hello} <strong>{t.hero.name}</strong><span class="wave" aria-hidden="true"><UiIcon name="sparkles" size={23} /></span></p>
          <h1 id="hero-heading">{t.hero.headlineA}<br /><em>{t.hero.headlineB}</em></h1>
          <p class="hero-summary">{t.hero.summary}</p>
          <div class="hero-ctas">
            <a class="button button-primary" href="#projects">{t.hero.projects}<UiIcon name="arrow" size={19} /></a>
            <a class="button button-outline" href={`mailto:${social.email}`}>{t.hero.contact}<UiIcon name="mail" size={18} /></a>
          </div>
          <div class="hero-location"><UiIcon name="map-pin" size={17} />{t.hero.location}</div>
        </div>
        <div class="hero-visual" aria-label={t.hero.portraitAlt}>
          <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
          <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
          <div class="visual-noise" aria-hidden="true"></div>
          <div class="portrait-frame">
            <!-- Replace this SVG with your own photo and update the src. -->
            <img src="/images/portrait-placeholder.svg" alt={t.hero.portraitAlt} width="630" height="750" fetchpriority="high" />
          </div>
          <div class="floating-note floating-note-top"><span class="note-symbol"><UiIcon name="sparkles" size={19} /></span><span>{t.hero.miniLabel}</span></div>
          <div class="floating-note floating-note-bottom"><span class="note-arrow" aria-hidden="true">↗</span><strong>{t.hero.cardTitle}</strong><small>{t.hero.cardCaption}</small></div>
          <span class="visual-corner-label" aria-hidden="true">F — I / 2026</span>
        </div>
        <a href="#projects" class="scroll-cue"><UiIcon name="arrow-down" size={16} /><span>{t.hero.scroll}</span></a>
      </section>

      <section class="proof-section container" aria-label="Highlights">
        <div class="proof-grid">
          <div class="proof-item"><strong dir={isFa ? 'rtl' : 'ltr'}>{t.proof.oneValue}</strong><span>{t.proof.oneLabel}</span></div>
          <div class="proof-item"><strong dir={isFa ? 'rtl' : 'ltr'}>{t.proof.twoValue}</strong><span>{t.proof.twoLabel}</span></div>
          <div class="proof-item"><strong dir={isFa ? 'rtl' : 'ltr'}>{t.proof.threeValue}</strong><span>{t.proof.threeLabel}</span></div>
        </div>
      </section>

      <section class="section projects-section container" id="projects" aria-labelledby="projects-heading">
        <div class="section-intro">
          <div><h2 id="projects-heading">{t.section.projectTitle}</h2></div>
        </div>
        <div class="projects-grid">
          {t.projectCards.map((project, index) => (
            <article class:list={['project-card', index === 0 && 'project-featured']}>
              <div class="project-info">
                <div class="project-topline"><span class="project-count" dir="ltr">0{index + 1}</span><span class="project-category">{project.category}</span></div>
                <div class="project-content"><h3>{project.title}</h3><p>{project.description}</p></div>
                <div class="project-foot">
                  <div class="project-tags">{project.labels.map((label) => <span>{label}</span>)}</div>
                  <div class="project-takeaway"><span class="takeaway-spark" aria-hidden="true"><UiIcon name="sparkles" size={17} /></span>{project.takeaway}</div>
                </div>
              </div>
              <div class:list={['project-visual', `project-visual-${project.key}`]}>
                <img src={project.image} alt={project.alt} width="760" height="540" loading="lazy" />
                <span class="mockup-label">{t.section.imageMock}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section expertise-section" id="expertise" aria-labelledby="skills-heading">
        <div class="container">
          <div class="section-intro">
            <div><h2 id="skills-heading">{t.section.skillsTitle}</h2></div>
          </div>
          <div class="skills-list">
                  {skills.map(skill => (
                    <div class="skill-chip" title={skill.name}>
                      <div class="skill-logo"><span aria-hidden="true">{skill.fallback}</span><img src={skill.icon} alt="" loading="lazy" decoding="async" width="38" height="38" /></div>
                      <span dir="ltr">{skill.name}</span>
                    </div>
                  ))}
                </div>
        </div>
      </section>

      <section class="section journey-section container" id="experience" aria-labelledby="experience-heading">
        <div class="journey-heading">
          <h2 id="experience-heading">{t.section.experienceTitle}</h2>
          <div class="journey-graphic" aria-hidden="true"><span class="journey-graphic-orbit"></span><span class="journey-graphic-center">F.</span><span class="journey-graphic-star"><UiIcon name="sparkles" size={43} /></span></div>
          <div class="education-card"><div class="education-icon"><UiIcon name="graduation" size={21} /></div><div><span>{t.section.education}</span><strong>{t.school.name}</strong><small>{t.school.degree} · {t.school.year}</small></div></div>
        </div>
        <div class="timeline">
          {t.jobs.map((job, index) => (
            <article class="timeline-item">
              <span class:list={['timeline-marker', job.current && 'marker-current']} aria-hidden="true"></span>
              <div class="timeline-inner">
                <span class="timeline-period">{job.period}</span>
                <div class="timeline-heading"><h3>{job.company}</h3><span class="timeline-role">{job.role}</span></div>
                <p>{job.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-heading">
        <div class="container contact-inner">
          <div class="contact-copy">
            <h2 id="contact-heading">{t.section.contactTitleA}<br /><em>{t.section.contactTitleB}</em></h2>
            <p>{t.section.contactSubtitle}</p>
            <a class="button button-gold" href={`mailto:${social.email}`}>{t.section.email}<UiIcon name="arrow" size={19} /></a>
          </div>
          <div class="contact-art" aria-hidden="true"><svg class="contact-asterisk" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M150 12V288M12 150H288M52 52L248 248M248 52L52 248" stroke="currentColor" stroke-width="24" stroke-linecap="round" /></svg><div class="contact-ring contact-ring-one"></div><div class="contact-ring contact-ring-two"></div><span class="contact-art-mark">LET'S / BUILD</span></div>
          <div class="contact-social"><div class="social-links">
            <a href={social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><UiIcon name="github" size={22} /></a>
            <a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><UiIcon name="linkedin" size={22} /></a>
            <a href={`mailto:${social.email}`} aria-label="Email"><UiIcon name="mail" size={22} /></a>
          </div></div>
        </div>
      </section>
    </main>

    <footer class="site-footer container">
      <div class="footer-brand"><span>{t.footer.rights.replace('{year}', String(year))}</span></div>
      <span class="footer-middle">{t.section.footerTag}</span>
      <a class="back-top" href="#top">{t.footer.backToTop}<span aria-hidden="true">↑</span></a>
    </footer>
  </div>
</BaseLayout>
